# Core
DATABASE_URL=postgresql+psycopg://atlas:atlas@postgres:5432/atlas
ATLAS_AUTH_MODE=demo
ATLAS_DEMO_ORG_ID=org_atlas_demo
ATLAS_DEMO_ROLE=admin
NEXT_PUBLIC_AUTH_MODE=demo
CORS_ORIGINS=http://localhost:3000

# Auth0 API (required when ATLAS_AUTH_MODE=auth0)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.atlas.local
AUTH0_ISSUER=https://your-tenant.us.auth0.com/

# Next.js / Auth0 web application
AUTH0_SECRET=replace-with-a-long-random-value
APP_BASE_URL=http://localhost:3000
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ORG_ID=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_INTERNAL_URL=http://api:8000/api/v1

# Optional local advisory AI
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
